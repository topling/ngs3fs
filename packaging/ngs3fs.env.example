# Install as /etc/ngs3fs/NAME.env with mode 0600, then enable
# ngs3fs@NAME.service. The mountpoint is /mnt/ngs3fs/NAME.
AWS_REGION=us-east-1
AWS_PROFILE=ngs3fs
NGS3FS_OPTIONS=--endpoint-host bucket.s3.us-east-1.amazonaws.com --authority bucket.s3.us-east-1.amazonaws.com:443 --endpoint-port 443 --bucket bucket --tls --part-size 128MiB --max-uploads 4 --max-connections 8 --stats-interval 60
